<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="D:\home\site\wwwroot\env\Scripts\python.exe" arguments="-m gunicorn --bind 127.0.0.1:%HTTP_PLATFORM_PORT% --workers 2 dmduproject.wsgi" startupTimeLimit="60" processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PYTHONPATH" value="D:\home\site\wwwroot" />
        <environmentVariable name="DJANGO_SETTINGS_MODULE" value="dmduproject.settings" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
